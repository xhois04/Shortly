@{
    ViewData["Title"] = "Welcome";
}

<section class="landing py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-4">
                <!--comment -->
            </div>
            <div class="col-lg-8">
                <h1 class="display-4">Welcome to Shortly</h1>
                <p class="lead">Shortly is a URL shortening service that allows you to create short, easy-to-share links for your long URLs. With Shortly, you can easily share your favorite websites, articles, and more with just a few clicks.</p>
            </div>
        </div>
    </div>
</section>

<section class="features" id="features">
    <div class="container">
        <div class="url-shorten-feature">
            <form class="url-shorten-form" id="url-shorten-form" action="/Home/ShortenAction" method="post">
                <div>
                    <input type="text" class="url-input" name="urlToShorten" placeholder="Enter a URL to shorten" />
                    <span class="alert"></span>
                </div>
                <button type="submit" class="btn btn-lg">Shorten It!</button>
            </form>
        </div>
    </div>
</section>